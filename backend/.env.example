# Copia este archivo a .env y rellena los valores para tu instalación.

# ── Django ───────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Nombre de tu empresa (aparece en el PDF del DeCA, en los informes exportados
# y en el email de envío) -- una instalación = una empresa, no hay tabla Empresa.
EMPRESA_NOMBRE=Mi Empresa de Transporte S.L.
TIME_ZONE=Europe/Madrid
LANGUAGE_CODE=es

# Orígenes del frontend autorizados a llamar a esta API (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────
DB_NAME=appodo_deca
DB_USER=appodo_deca
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432

# ── IA (extracción automática de campos, opcional) ──────────────────────
# Sin esta clave, la extracción por IA (texto o visión) simplemente no se
# intenta -- la extracción por regex (extraction_service.py) sigue
# funcionando igual, es independiente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IA_TIMEOUT_SEGUNDOS=30

# ── Email saliente (SMTP) ────────────────────────────────────────────────
# Usado para el envío manual del PDF del DeCA por email
# (EnviarEmailExpedicionDecaView). Sin configurar, el envío devuelve un
# error legible en vez de fallar en silencio.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# ── Almacenamiento de ficheros ───────────────────────────────────────────
MEDIA_ROOT=media
MEDIA_URL=/media/
