# Copia este archivo a .env (en la raíz del repo) antes de "docker compose up".
# El backend lee estas mismas variables -- ver backend/.env.example para la
# explicación detallada de cada una (aquí solo los valores a rellenar).

# ── Django ───────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
EMPRESA_NOMBRE=Mi Empresa de Transporte S.L.
TIME_ZONE=Europe/Madrid
LANGUAGE_CODE=es
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ── Base de datos (PostgreSQL, servicio "db" del docker-compose) ────────
DB_NAME=appodo_deca
DB_USER=appodo_deca
DB_PASSWORD=cambia-esto-por-una-contraseña-fuerte

# ── IA (extracción automática de campos, opcional) ──────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
IA_TIMEOUT_SEGUNDOS=30

# ── Email saliente (SMTP, opcional -- sin esto el envío por email da un
#    error legible en vez de fallar en silencio) ─────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# ── Frontend / puertos ────────────────────────────────────────────────────
# Puerto en el que se publica la app en tu máquina/servidor (nginx del frontend).
HTTP_PORT=8080
# Déjalo vacío si sirves frontend y backend con el mismo dominio (nginx hace de
# proxy de /api hacia el backend, ver frontend/nginx.conf) -- es lo normal en
# un despliegue con docker-compose tal cual. Solo rellénalo si el frontend se
# sirve desde un dominio/puerto distinto al backend.
VITE_API_URL=
